<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ title }}</title><link rel="stylesheet" href="style.css"></head><body>
<p><a href="index.html">&larr; All weeks</a></p>
<h1>{{ title }}</h1><p>Week {{ iso_week }}</p>
<details class="section" open><summary><h2>Management summary</h2></summary><ul class="management-summary">{% for line in management_summary %}<li class="management-summary-item"><p>{{ line.text }}</p>{% if line.sources %}<div class="summary-sources" role="group" aria-label="Sources ({{ line.sources|length }})"><span class="summary-sources-label">Sources · {{ line.sources|length }}</span>{% for source in line.sources[:3] %}<a class="summary-source" href="{{ source.url }}" title="{{ source.title }}" aria-label="{{ source.source_title }}: {{ source.title }}"><span class="summary-source-publisher">{{ source.source_title }}</span><span class="summary-source-title">{{ source.title }}</span></a>{% endfor %}{% if line.sources|length > 3 %}<details class="summary-more"><summary><span class="summary-more-count">+{{ line.sources|length - 3 }} more</span><span class="summary-more-less">Show fewer</span></summary><div class="summary-more-list">{% for source in line.sources[3:] %}<a class="summary-source" href="{{ source.url }}" title="{{ source.title }}" aria-label="{{ source.source_title }}: {{ source.title }}"><span class="summary-source-publisher">{{ source.source_title }}</span><span class="summary-source-title">{{ source.title }}</span></a>{% endfor %}</div></details>{% endif %}</div>{% endif %}</li>{% endfor %}</ul></details>
<details class="section" open><summary><h2>Calls to action</h2></summary><ul>{% for action in calls_to_action %}<li><strong>{{ action.title }}</strong> — {{ action.why }}</li>{% endfor %}</ul></details>
{% for area, items in sections.items() %}<details class="section"><summary><h2>{{ area }} <span class="count">{{ items|length }}</span></h2></summary>{% for item in items %}
<article><h3><a href="{{ item.url }}">{{ item.title }}</a></h3><p>{{ item.ai_summary }}</p>
<p>{{ item.source_title }} · {{ item.release_status }} · {{ item.action }} — {{ item.action_reason }}</p></article>{% endfor %}</details>{% endfor %}
{% if health_counts %}<details class="section"><summary><h2>Source health</h2></summary><p>{% for state, count in health_counts.items() %}{{ state }}: {{ count }}{% if not loop.last %} · {% endif %}{% endfor %}</p></details>{% endif %}
{% if failed_sources %}<details class="section"><summary><h2>Sources with errors <span class="count">{{ failed_sources|length }}</span></h2></summary><ul>{% for failure in failed_sources %}<li><a href="{{ failure.url }}">{{ failure.title }}</a>: {{ failure.error }}</li>{% endfor %}</ul></details>{% endif %}
</body></html>
